{
    "compilerOptions": {
        "outDir"          : "dist",
        "strict"          : true,
        "target"          : "ES2022",
        "module"          : "commonjs",
        "sourceMap"       : true,
        "esModuleInterop" : true,
        "moduleResolution": "node",
        "noImplicitAny"   : true,
        "baseUrl"         : ".",
        "paths"           : {
            "*": [
                "node_modules/*"
            ]
        }
    },
    "include"        : [
        "src/**/*"
    ],
    "exclude"        : [
        "assets/**/*"
    ]
}
