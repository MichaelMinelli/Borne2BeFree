{
    "name"           : "borneo-backend",
    "description"    : "Alma Self-Checkout tool that doesn't use CORS",
    "version"        : "2.0.0",
    "private"        : true,
    "main"           : "dist/src/app.js",
    "author"         : "Michaël Minelli <git@minelli.swiss>",
    "license"        : "GPLv3",
    "scripts"        : {
        "clean"        : "rm -R dist/*",
        "lint"         : "npx eslint .",
        "build:project": "npx tsc --project ./ && cp -R assets dist/assets",
        "build"        : "npm run build:project",
        "start:dev"    : "npx nodemon src/app.ts",
        "start:prod"   : "NODE_ENV=production npx node dist/src/app.js"
    },
    "repository"     : {
        "type": "git",
        "url" : "git+https://github.com/MichaelMinelli/Borneo.git"
    },
    "keywords"       : [
        "alma"
    ],
    "bugs"           : {
        "url": "https://github.com/MichaelMinelli/Borneo/issues"
    },
    "homepage"       : "https://github.com/MichaelMinelli/Borneo#readme",
    "dependencies"   : {
        "axios"               : "^1.9.0",
        "compression"         : "^1.8.0",
        "cors"                : "^2.8.5",
        "express"             : "^5.1.0",
        "fs-extra"            : "^11.3.0",
        "helmet"              : "^8.1.0",
        "http-status-codes"   : "^2.3.0",
        "jsonwebtoken"        : "^9.0.2",
        "morgan"              : "^1.10.0",
        "node"                : "^22.16.0",
        "winston"             : "^3.17.0",
        "zod"                 : "^3.25.67",
        "zod-validation-error": "^3.5.2"
    },
    "devDependencies": {
        "@eslint/js"         : "^9.29.0",
        "@types/compression" : "^1.8.1",
        "@types/cors"        : "^2.8.19",
        "@types/express"     : "^5.0.2",
        "@types/fs-extra"    : "^11.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan"      : "^1.9.10",
        "@types/node"        : "^22.15.32",
        "eslint"             : "^9.29.0",
        "nodemon"            : "^3.1.10",
        "npm"                : "^11.4.2",
        "tsx"                : "^4.20.3",
        "typescript"         : "^5.8.3",
        "typescript-eslint"  : "^8.32.1"
    }
}
