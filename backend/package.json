{
    "name"           : "borne2befree-backend",
    "description"    : "Alma Self-Checkout tool that doesn't use CORS",
    "version"        : "2.0.0",
    "private"        : true,
    "main"           : "dist/src/app.js",
    "author"         : "Michaël Minelli <git@minelli.swiss>",
    "license"        : "GPLv3",
    "scripts"        : {
        "clean"        : "rm -R dist/*",
        "lint"         : "npx eslint .",
        "build:project": "npx tsc --project ./ && cp -R assets dist/assets",
        "build"        : "npm run build:project",
        "start:dev"    : "npx nodemon src/app.ts",
        "start:prod"   : "NODE_ENV=production npx node dist/src/app.js"
    },
    "repository"     : {
        "type": "git",
        "url" : "git+https://github.com/MichaelMinelli/Borne2BeFree.git"
    },
    "keywords"       : [
        "alma"
    ],
    "bugs"           : {
        "url": "https://github.com/MichaelMinelli/Borne2BeFree/issues"
    },
    "homepage"       : "https://github.com/MichaelMinelli/Borne2BeFree#readme",
    "dependencies"   : {
        "axios"            : "^1.9.0",
        "compression"      : "^1.8.0",
        "cors"             : "^2.8.5",
        "express"          : "^5.1.0",
        "fs-extra"         : "^11.3.0",
        "helmet"           : "^8.1.0",
        "http-status-codes": "^2.3.0",
        "morgan"           : "^1.10.0",
        "node"             : "^22.16.0",
        "winston"          : "^3.17.0"
    },
    "devDependencies": {
        "@eslint/js"        : "^9.27.0",
        "@types/compression": "^1.8.0",
        "@types/cors"       : "^2.8.18",
        "@types/express"    : "^5.0.2",
        "@types/fs-extra"   : "^11.0.4",
        "@types/morgan"     : "^1.9.9",
        "@types/node"       : "^22.15.21",
        "eslint"            : "^9.27.0",
        "nodemon"           : "^3.1.10",
        "npm"               : "^11.4.1",
        "tsx"               : "^4.19.4",
        "typescript"        : "^5.8.3",
        "typescript-eslint" : "^8.32.1"
    }
}
